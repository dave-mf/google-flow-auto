{
  "manifest_version": 3,
  "name": "Google Flow Prompt Auto",
  "version": "0.2.7",
  "description": "Automate Google Flow prompt batches from a .txt file.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "debugger",
    "tabs"
  ],
  "host_permissions": [
    "https://labs.google/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Flow Prompt Auto"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/id/tools/flow/*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  }
}
